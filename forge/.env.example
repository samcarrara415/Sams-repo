# Copy to .env and fill in what you need. server.js reads .env on startup.

# Port and interface to listen on. The C++ runner executes arbitrary code, so
# the default is loopback only. Use HOST=0.0.0.0 only on a trusted network.
PORT=3000
HOST=127.0.0.1

# Optional. If set, everyone who can reach the server uses this key and nobody
# is asked for their own. Meant for a single-user, self-hosted setup.
# ANTHROPIC_API_KEY=

# Optional. Model selected for new sessions: claude-opus-5-5 (default),
# claude-sonnet-5-5 or claude-haiku-5-5.
# DEFAULT_MODEL=claude-opus-5-5

# Optional. Secret for signing the session cookie. A random one is generated
# on each start, which is fine because sessions are kept in memory anyway.
# SESSION_SECRET=

# Optional. Point the Anthropic client at another base URL, e.g. a local mock
# for testing. Leave unset to use the real API.
# ANTHROPIC_BASE_URL=
