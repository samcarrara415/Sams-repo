# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic: console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Stripe: Dashboard > Developers
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# ID of an $8/month recurring price
STRIPE_MONTHLY_PRICE_ID=price_...

# Public URL of the deployed app, no trailing slash. Used for Stripe redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# The account with this (confirmed) email can open /admin and create promo codes.
ADMIN_EMAIL=you@example.com
